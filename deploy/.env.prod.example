# Copy to deploy/.env.prod (chmod 600) on the server. Never commit the real file.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_THINKING_LEVEL=low
GEMINI_API_KEY=your-key-here
DATABASE_PATH=/app/state/feedback_agent.db
TRACE_DIR=/app/state/traces

# Protection for a public demo (see README, "Live demo")
API_TOKEN=generate-a-long-random-token
RATE_LIMIT_PER_MIN=6
DAILY_REQUEST_LIMIT=60
DAILY_TOKEN_LIMIT=600000
