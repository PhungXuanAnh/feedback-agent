# Copy to .env and fill in:  cp .env.example .env     (never commit .env)
#
# Where this file is read:
#   - Docker Compose reads .env next to docker-compose.yml and passes the variables marked [compose] into the container.
#   - Without Docker the app loads .env itself (every variable below works).
# A variable that is commented out (leading #) is optional. For the first group the value shown is the default; for the
# shared-deployment protection group the values (10, 100, 1000000, 1) are examples to use when you switch the feature on:
# the real default is OFF.

# ---------------------------------------------------------------- LLM provider
# Provider: gemini (real model, needs a key) or scripted (offline replay of recorded turns; used by tests, samples and the demo).  [compose]
LLM_PROVIDER=gemini

# Model id. It is configuration, not code, so switching models never needs a code change. Required for the gemini provider.  [compose]
LLM_MODEL=gemini-3.8-flash

# Gemini API key. Only POST /feedback and live runs need it; the API starts and /health passes without it.
# LLM_API_KEY is accepted as an alias.  [compose]
GEMINI_API_KEY=your-key-here

# Gemini endpoint (default shown). Change it only to point at a proxy or a test double.
# LLM_BASE_URL=https://generativelanguage.googleapis.com

# Sampling temperature. Unset = the provider default.
# LLM_TEMPERATURE=

# Gemini 3 thinking level: minimal | low | medium | high. "low" cut median latency from about 13 s to 5 s and used far fewer tokens
# in the sweep (README 1.5). Empty = the model default (slower, more tokens).  [compose]
LLM_THINKING_LEVEL=low

# ---------------------------------------------------------------- Agent limits
# Two separate, enforced caps on the agent loop (README 1.4.4).
# MAX_LLM_TURNS: LLM turns in the loop, including the forced-submit and repair turns; the classify call is counted separately.
#   4 = the typical 2 turns + one repair + one spare. 2-6 behaved the same in the sweep; the cap is only a ceiling.  [compose]
MAX_LLM_TURNS=4
# MAX_TOOL_CALLS: tool calls that reach a data source; cache hits and submit_report are free.  [compose]
MAX_TOOL_CALLS=6
# Per-call output limit. Gemini 3 thinking tokens count against it: at 2048 the long submit_report call was cut off
# on 2 of 14 eval cases, 8192 fixed it.  [compose]
MAX_OUTPUT_TOKENS=8192

# ---------------------------------------------------------------- Cost estimate
# Price in USD per million tokens. Cost is estimated only when BOTH are set; otherwise it is reported as "unknown" (never 0).  [compose]
# PRICE_PER_MTOK_IN=
# PRICE_PER_MTOK_OUT=

# ---------------------------------------------------------------- Storage
# SQLite file (reports, reviews, usage counters) and the folder for JSONL traces, one file per run.
# In Docker they live in the "state" volume, so these two are not passed through compose.
DATABASE_PATH=data/feedback_agent.db
TRACE_DIR=traces

# ---------------------------------------------------------------- Protection for a shared deployment
# All optional and OFF when unset. Used by the hosted demo (deploy/DEPLOY.md); docker-compose.yml (local) does not pass them,
# deploy/docker-compose.prod.yml does.
# API_TOKEN: clients must send the header X-API-Token. /health and /docs stay open.
# API_TOKEN=
# RATE_LIMIT_PER_MIN: POST /feedback requests per minute per client IP (429 beyond it).
# RATE_LIMIT_PER_MIN=10
# DAILY_REQUEST_LIMIT: reports per UTC day, all clients together. Counted in SQLite, so a restart does not reset it.
#   Checked before each request, so requests already in flight can exceed it (not a hard billing cap).
# DAILY_REQUEST_LIMIT=100
# DAILY_TOKEN_LIMIT: prompt + output tokens per UTC day, all clients together (same behaviour as the request limit).
# DAILY_TOKEN_LIMIT=1000000
# TRUST_PROXY: 1 = take the client IP from X-Forwarded-For (rate limit per real client). Set it only behind your own reverse proxy,
#   otherwise clients could spoof the header.
# TRUST_PROXY=1
