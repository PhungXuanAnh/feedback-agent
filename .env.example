# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini            # gemini | scripted
LLM_MODEL=gemini-3.8-flash     # model id is configuration, not code
GEMINI_API_KEY=your-key-here   # LLM_API_KEY is accepted as an alias
# LLM_BASE_URL=https://generativelanguage.googleapis.com
# LLM_TEMPERATURE=             # unset = provider default
LLM_THINKING_LEVEL=low            # minimal | low | medium | high; empty = model default (slower, more tokens)

# Agent limits (see README "Step caps")
MAX_LLM_TURNS=4
MAX_TOOL_CALLS=6
MAX_OUTPUT_TOKENS=8192

# Optional cost estimate: leave unset and cost is reported as "unknown".
# PRICE_PER_MTOK_IN=
# PRICE_PER_MTOK_OUT=

DATABASE_PATH=data/feedback_agent.db
TRACE_DIR=traces
